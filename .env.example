# Copie para .env e preencha. O .env nunca é versionado.
# Painel do Supabase: Project Settings -> API

# URL do projeto (https://<ref>.supabase.co)
VITE_SUPABASE_URL=

# Chave anonima / publishable. Publica por design: vai no bundle do navegador.
# O que protege os dados e o RLS, nao o segredo desta chave.
VITE_SUPABASE_ANON_KEY=

# ATENCAO: a chave service_role / secret NAO entra aqui.
# Ela ignora o RLS e so pode existir no ambiente da Edge Function,
# onde o proprio Supabase ja a injeta. Nunca no frontend, nunca no repositorio.

# --------------------------------------------------------------------
# Contas usadas pelo teste de isolamento (testes/isolamento.test.ts).
# Sem prefixo VITE_ de proposito: nao entram no bundle.
# Use dois e-mails descartaveis, nao os seus de verdade.
TESTE_USUARIO_A_EMAIL=
TESTE_USUARIO_A_SENHA=
TESTE_USUARIO_B_EMAIL=
TESTE_USUARIO_B_SENHA=

# --------------------------------------------------------------------
# Notificacoes push (Etapa 7). Geradas por scripts, nao inventadas a mao.
# A publica vai no bundle de proposito — e ela que o navegador usa para
# assinar. A privada e o segredo do agendador NUNCA vao para o frontend:
# vivem so como secrets da Edge Function no painel do Supabase.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SEGREDO_AGENDADOR=
