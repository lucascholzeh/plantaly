# Copie para .env e preencha. O .env nunca é versionado.
# Painel do Supabase: Project Settings -> API

# URL do projeto (https://<ref>.supabase.co)
VITE_SUPABASE_URL=

# Chave anonima / publishable. Publica por design: vai no bundle do navegador.
# O que protege os dados e o RLS, nao o segredo desta chave.
VITE_SUPABASE_ANON_KEY=

# ATENCAO: a chave service_role / secret NAO entra aqui.
# Ela ignora o RLS e so pode existir no ambiente da Edge Function,
# onde o proprio Supabase ja a injeta. Nunca no frontend, nunca no repositorio.
